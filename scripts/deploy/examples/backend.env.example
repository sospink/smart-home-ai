# Smart Home backend runtime config
# Copy to /home/ubuntu/projects/smart-home/app/shared/backend.env and fill in real values.

DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/smart_home
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DIFY_BASE_URL=http://42.240.132.79
DIFY_API_KEY=replace-with-dify-app-key
DIFY_DATASET_API_KEY=replace-with-dify-dataset-key

HA_BASE_URL=http://42.240.132.79:8123
HA_TOKEN=replace-with-home-assistant-token

OLLAMA_BASE_URL=http://127.0.0.1:11434
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=smart-home
INFLUXDB_BUCKET=smart-home-data

AGENT_API_KEY=replace-with-agent-api-key
CORS_ORIGINS=["http://42.240.132.79:8088"]
