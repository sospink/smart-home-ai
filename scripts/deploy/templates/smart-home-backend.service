[Unit]
Description=Smart Home Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=__REMOTE_ROOT__/current/backend
EnvironmentFile=__REMOTE_ROOT__/shared/backend.env
ExecStart=/usr/bin/bash -lc 'exec ./.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port __BACKEND_PORT__'
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
