# ═══════════════════════════════════════════
#  Smart Home AI Platform — .gitignore
# ═══════════════════════════════════════════

# ── OS ──
.env
.playwright-cli/
.playwright-mcp/
output/
docs/research/*session-context.md
docs/research/*会话可见对话脱敏归档.md
docs/delivery/evidence/
*.tsbuildinfo

.DS_Store
Thumbs.db

# ── Logs ──
*.log
.backend.log
.frontend.log
.logs/

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ═══════════════════════════════════════════
#  Python / FastAPI Backend
# ═══════════════════════════════════════════
venv/
smart-home-ai-backend/venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# 环境变量（包含密钥，绝不提交）
smart-home-ai-backend/.env
smart-home-ai-backend/backend.env
deploy-kit/cloud-migration/config/migration.env

# ═══════════════════════════════════════════
#  Next.js / React Frontend
# ═══════════════════════════════════════════
node_modules/
smart-home-ai-frontend/node_modules/
.next/
smart-home-ai-frontend/.next/
out/

# 环境变量
smart-home-ai-frontend/.env.local
smart-home-ai-frontend/.env*.local

# ═══════════════════════════════════════════
#  Misc
# ═══════════════════════════════════════════
*.sqlite3
*.db

# ── Cloud migration runtime artifacts ──
build/migration/
deploy-kit/**/*.env
!deploy-kit/**/*.env.example
*.sql
*.sql.gz
*.dump
*.backup
*.tar
*.tar.gz
*.tgz
*.img
*.docker-image
*secrets*
*secret*
