# Smart Home 核心全量迁移配置模板
# 复制为 config/migration.env 后填写真实服务器信息；不要提交 migration.env。

# ── 源服务器（当前运行环境） ─────────────────────────────
SOURCE_HOST=42.240.132.79
SOURCE_USER=ubuntu
SOURCE_SSH_PORT=22
SOURCE_APP_ROOT=/home/ubuntu/projects/smart-home/app
SOURCE_DIFY_DOCKER_DIR=/home/ubuntu/dify/docker
SOURCE_DOCKER_SERVICE_DIR=/home/ubuntu/projects/smart-home/docker-service

# ── 目标服务器（新云服务器） ─────────────────────────────
TARGET_HOST=
TARGET_USER=ubuntu
TARGET_SSH_PORT=22
TARGET_PUBLIC_HOST=
TARGET_PUBLIC_PORT=8088
TARGET_APP_ROOT=/home/ubuntu/projects/smart-home/app
TARGET_DIFY_DOCKER_DIR=/home/ubuntu/dify/docker
TARGET_DOCKER_SERVICE_DIR=/home/ubuntu/projects/smart-home/docker-service

# 如果目标服务器必须密码 SSH / sudo，填写；使用 SSH 私钥且免密 sudo 时可留空。
TARGET_SSH_PASSWORD=
TARGET_SUDO_PASSWORD=

# ── 应用运行配置重写 ───────────────────────────────────
TARGET_PUBLIC_BASE_URL=http://__TARGET_PUBLIC_HOST__:8088
TARGET_DIFY_BASE_URL=http://__TARGET_PUBLIC_HOST__
TARGET_HA_BASE_URL=http://__TARGET_PUBLIC_HOST__:8123
TARGET_INFLUXDB_URL=http://127.0.0.1:8086
TARGET_CORS_ORIGINS=["http://__TARGET_PUBLIC_HOST__:8088"]

# 迁移恢复后建议使用独立应用数据库用户，而不是 root。
TARGET_DATABASE_URL=mysql+aiomysql://smart_home:change-me@127.0.0.1:3306/smart_home_web

# ── InfluxDB ──────────────────────────────────────────
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-strong-password
INFLUXDB_ORG=smart-home
INFLUXDB_BUCKET=smart-home-data

# ── 本地产物目录 ──────────────────────────────────────
LOCAL_MIGRATION_ROOT=build/migration

# ── 迁移策略 ──────────────────────────────────────────
# core：默认，只迁移平台、MySQL、InfluxDB、Dify、Home Assistant。
MIGRATION_PROFILE=core
# online：目标服务器联网拉镜像。offline 暂不默认支持，只生成镜像清单。
IMAGE_MODE=online

