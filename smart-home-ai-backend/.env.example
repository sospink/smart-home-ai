# Local development
# - Dify: use the current LAN Dify service
# - Home Assistant: use the current walk-in training-bench LAN instance
# - Ollama: prefer local if running
# - InfluxDB: optional; leave empty/offline during local development

# Database (MySQL 8)
# If your password contains '@', it must be URL-encoded as '%40'
DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/smart_home_web

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External services
OLLAMA_BASE_URL=http://localhost:11434
HA_BASE_URL=http://192.168.251.190:8123
HA_TOKEN=paste_your_ha_long_lived_token_here
DIFY_BASE_URL=http://192.168.251.190
DIFY_API_KEY=paste_your_dify_api_key_here
DIFY_DATASET_API_KEY=paste_your_dify_dataset_api_key_here
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=paste_your_influxdb_token_here
INFLUXDB_ORG=smart-home
INFLUXDB_BUCKET=smart-home-data

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8088"]
